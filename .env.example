# ─────────────────────────────────────────────────────────────────────────────
# JWT Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Secret key used to sign JWT tokens.
# MUST be changed before deploying to production.
# Generate one with: openssl rand -base64 48
JWT_SECRET=WwEJCkJ8bkKhU6SV9XBQWfPqtyt95HrA3uZUvbzM5vS

# Token expiry in SECONDS.
# Default: 604800 (7 days)
# JWT_EXPIRES_IN=604800

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Credenciales individuales (usadas por docker-compose.yml)
DB_USER=apiapp
DB_PASSWORD=apiapp_secret
DB_NAME=apiapp_db

# URL completa de conexión (usada por Prisma).
# En local con Docker Compose: cambia "localhost" por "db" (nombre del servicio).
# En desarrollo sin Docker: usa localhost:5432
DATABASE_URL=postgresql://apiapp:apiapp_secret@localhost:5432/apiapp_db?schema=public
