// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema – api-app
// Proveedor: PostgreSQL
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Modelo: User
// Refleja la interfaz User del módulo auth.
//  - id              → UUID generado por la BD (default: gen_random_uuid())
//  - email           → único, siempre en minúsculas (enforced en servicio)
//  - passwordHash    → hash bcrypt de la contraseña (nunca texto plano)
//  - biometricToken  → token opaco generado en el cliente Expo y almacenado
//                      en expo-secure-store; se envía para autenticación
//                      biométrica sin revelar la contraseña.
//  - createdAt       → timestamp de creación (automático)
//  - updatedAt       → timestamp de última actualización (automático)
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.Text
  /// Token biométrico registrado desde el dispositivo Expo.
  /// Almacenado como hash en prod; aquí se guarda el valor opaco.
  biometricToken String?  @map("biometric_token") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  baseCurrency Currency @default(USD) @map("base_currency")

  accounts      Account[]
  categories    Category[]
  budgets       Budget[]
  subscriptions Subscription[]

  @@map("users")
}

enum Currency {
  USD
  VES
  EUR
  BTC
  ETH
  USDT
}

model Account {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @map("name") @db.VarChar(100)
  currency  Currency @map("currency")
  balance   Decimal  @default(0.00) @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  subscriptions Subscription[]

  @@map("accounts")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  color     String   @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]
  subscriptions Subscription[]

  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String          @map("account_id") @db.Uuid
  categoryId  String?         @map("category_id") @db.Uuid
  amount      Decimal         @db.Decimal(15, 2)
  type        TransactionType
  description String?         @db.Text
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

enum SubscriptionFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model Subscription {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  accountId       String                @map("account_id") @db.Uuid
  categoryId      String?               @map("category_id") @db.Uuid
  name            String                @db.VarChar(100)
  amount          Decimal               @db.Decimal(15, 2)
  frequency       SubscriptionFrequency
  nextPaymentDate DateTime              @map("next_payment_date")
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("subscriptions")
}

model Budget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  amount     Decimal  @db.Decimal(15, 2)
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("budgets")
}
